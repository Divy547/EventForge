# ==============================================================================
# EventForge — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env or inject these variables via your secrets manager
# (AWS Secrets Manager, HashiCorp Vault, Kubernetes Secrets, etc.)
#
# IMPORTANT:
# - Replace placeholder credentials with cryptographically secure values.
# - DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Application Runtime
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# PostgreSQL Database Configuration
# In production Docker Compose, 'postgres' is the container service name.
POSTGRES_USER=postgres
# REQUIRED: docker-compose.prod.yml refuses to start if this is unset.
# Generate with: openssl rand -hex 24   (hex avoids URL-escaping problems in connection strings)
POSTGRES_PASSWORD=generate_a_cryptographically_secure_password_here
POSTGRES_DB=eventforge
# Only used when running the API/worker outside compose; compose builds its own DATABASE_URL.
DATABASE_URL=postgresql://postgres:generate_a_cryptographically_secure_password_here@postgres:5432/eventforge
DATABASE_MAX_CONNECTIONS=20

# Redis Configuration (BullMQ Queue & Event Coordination)
# In production Docker Compose, 'redis' is the container service name.
REDIS_URL=redis://redis:6379

# Transactional Outbox & Poller Configuration
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_LOCK_TIMEOUT_MS=30000

# Background Worker & Dispatcher Configuration
WORKER_PORT=3001
# Bind to 0.0.0.0 in containers so health checks and Prometheus scrapers can connect
WORKER_HOST=0.0.0.0
WORKER_CONCURRENCY=10
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=5
DELIVERY_LEASE_TIMEOUT_MS=60000
STALE_RECOVERY_INTERVAL_MS=30000

# API Protection
# Bearer token required to scrape the API's /metrics (min 16 chars). If unset in production,
# /metrics is disabled. Generate with: openssl rand -hex 24
METRICS_TOKEN=
# Fixed-window request limits (per API key, and per client IP which also throttles bad-key guessing)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_KEY_MAX=1200
RATE_LIMIT_IP_MAX=2400
# Comma-separated browser origins allowed to call the API cross-origin. Empty = none.
CORS_ALLOWED_ORIGINS=
# Number of reverse proxies in front of the API (e.g. 1 for Caddy) so client IPs are read correctly.
TRUST_PROXY_HOPS=0

# Data Retention (worker): completed deliveries and processed events older than this many days
# are deleted. PENDING/IN_FLIGHT/FAILED/DEAD_LETTER deliveries are never deleted. 0 disables.
RETENTION_DAYS=30
RETENTION_INTERVAL_MS=3600000
RETENTION_BATCH_SIZE=1000

# SSRF Protection & Security Guardrails
# In production, ALLOW_LOCAL_WEBHOOKS MUST NEVER be true.
# Any attempt to start in production with ALLOW_LOCAL_WEBHOOKS=true will fail immediately at boot.
ALLOW_LOCAL_WEBHOOKS=false
