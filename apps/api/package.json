{
  "name": "@eventforge/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src/ test/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --passWithNoTests",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern='.*\\.spec\\.ts$' --testPathIgnorePatterns='integration' --passWithNoTests",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern='.*\\.integration\\.spec\\.ts$' --runInBand --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@eventforge/common": "workspace:*",
    "@eventforge/config": "workspace:*",
    "@eventforge/database": "workspace:*",
    "@nestjs/common": "^11.0.10",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/swagger": "^11.0.6",
    "@nestjs/terminus": "^11.0.0",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eventforge/sdk": "workspace:*",
    "@eventforge/typescript-config": "workspace:*",
    "@jest/globals": "^29.7.0",
    "@nestjs/testing": "^11.0.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.3"
  }
}
