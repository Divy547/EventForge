# ==============================================================================
# EventForge — Local Development & Testing Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventforge
DATABASE_MAX_CONNECTIONS=20

# Redis
REDIS_URL=redis://localhost:6379

# Outbox & Dispatcher Configuration
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_LOCK_TIMEOUT_MS=30000

# Background Worker & Delivery Configuration
WORKER_PORT=3001
# In containerized/Kubernetes environments, set WORKER_HOST=0.0.0.0 for external scraper access
WORKER_HOST=127.0.0.1
WORKER_CONCURRENCY=10
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=5
DELIVERY_LEASE_TIMEOUT_MS=60000
STALE_RECOVERY_INTERVAL_MS=30000

# Security (ALLOW_LOCAL_WEBHOOKS must NEVER be enabled in production)
ALLOW_LOCAL_WEBHOOKS=false
