# ==============================================================================
# EventForge — Local Development & Testing Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventforge
DATABASE_MAX_CONNECTIONS=20

# Redis
REDIS_URL=redis://localhost:6379

# Outbox & Dispatcher Configuration
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# Background Worker & Delivery Configuration
WORKER_PORT=3001
# In containerized/Kubernetes environments, set WORKER_HOST=0.0.0.0 for external scraper access
WORKER_HOST=127.0.0.1
WORKER_CONCURRENCY=10
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=5
DELIVERY_LEASE_TIMEOUT_MS=60000
STALE_RECOVERY_INTERVAL_MS=30000

# Data Retention (0 disables). Only COMPLETED deliveries and fully processed events are deleted.
RETENTION_DAYS=30
RETENTION_INTERVAL_MS=3600000
RETENTION_BATCH_SIZE=1000

# API protection (all optional; defaults shown)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_KEY_MAX=1200
RATE_LIMIT_IP_MAX=2400
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=0
# METRICS_TOKEN=            # if set, API /metrics requires 'Authorization: Bearer <token>'

# Security (ALLOW_LOCAL_WEBHOOKS must NEVER be enabled in production)
ALLOW_LOCAL_WEBHOOKS=false

# Sandbox mode (public demo, off by default). When on, the dashboard's "Try the live sandbox" hands
# visitors a 1-hour key to a dedicated "sandbox" project whose subscriptions point at the API's
# built-in demo receiver. SANDBOX_RECEIVER_URL is how the WORKER reaches that receiver; it is the
# only private address the worker may call. Limits are per client IP and hour.
SANDBOX_ENABLED=false
# SANDBOX_RECEIVER_URL=http://localhost:3000/sandbox/receiver
SANDBOX_SESSIONS_PER_HOUR=10
SANDBOX_WRITES_PER_HOUR=60
